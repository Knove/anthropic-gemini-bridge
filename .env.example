# Required: Upstream API key (sent as x-goog-api-key)
OPENCODE_KEY=your_api_key_here

# Optional: Force a specific upstream Gemini model ID
# (If omitted, uses the "model" field from the incoming Anthropic request)
BRIDGE_MODEL=gemini-4-argon-contributor

# Optional: Local listen port (bound to 127.0.0.1)
BRIDGE_PORT=8799

# Optional: Default Gemini thinking level when the request does not specify effort
# Values: HIGH (default) | MEDIUM | LOW | OFF
BRIDGE_THINKING_LEVEL=HIGH

# Optional: Upstream Gemini generateContent base URL
BRIDGE_UPSTREAM=https://opencode.ai/inference/go/v1

# Optional: Set to 1 to log every outgoing SSE event and dump 4xx payloads to /tmp
BRIDGE_DEBUG_SSE=0
